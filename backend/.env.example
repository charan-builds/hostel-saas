NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated production origins allowed to submit mutation requests.
# NEXT_PUBLIC_APP_URL is included automatically; add extra custom/admin domains here.
# ALLOWED_ORIGINS=https://example.com,https://admin.example.com

# Paste the hosted project URL from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe public key. Never paste a secret/service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Server-only Supabase secret key. Prefer this over the legacy service-role JWT.
# This must never be prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_your_server_secret_key

# Optional legacy browser-safe anon key for older Supabase projects/tools.
# Runtime code uses NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_if_required_by_external_tools

# Optional legacy fallback if your Supabase project still uses service-role JWTs.
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key_if_required

# Optional CLI overrides. The link script can infer the project ref from
# NEXT_PUBLIC_SUPABASE_URL, and the CLI can also use a prior `supabase login`.
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_ACCESS_TOKEN=sbp_your_personal_access_token
# SUPABASE_DB_PASSWORD=your_database_password

# Required only for direct database tooling outside the Supabase CLI.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Optional shared secret for internal cron/worker HTTP entrypoints.
# Use a random 32+ character value in production.
# JOB_RUNNER_SECRET=replace_with_a_random_internal_job_secret

# Phone auth defaults. Use the market default for non-E.164 student phone input.
AUTH_DEFAULT_PHONE_COUNTRY_CODE=+91

# Cashfree online payment orchestration. Keep all values server-only.
# CASHFREE_ENV=sandbox
# CASHFREE_APP_ID=your_cashfree_app_id
# CASHFREE_SECRET_KEY=your_cashfree_secret_key
# CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret_or_secret_key

# Security headers.
# Keep CSP report-only initially; switch to enforce after production reports are clean.
# Valid values: report-only, enforce, off.
SECURITY_HEADERS_CSP_MODE=report-only

# Optional HTTPS endpoint for CSP violation collection.
# SECURITY_HEADERS_CSP_REPORT_URI=https://csp-report.example.com/report

# Optional comma-separated CSP allowlist extensions for trusted third parties.
# Keep these empty unless a provider is actively used by the app.
# SECURITY_HEADERS_CSP_EXTRA_CONNECT_SRC=https://api.example-provider.com
# SECURITY_HEADERS_CSP_EXTRA_FRAME_SRC=https://checkout.example-provider.com
# SECURITY_HEADERS_CSP_EXTRA_IMG_SRC=https://images.example-cdn.com
# SECURITY_HEADERS_CSP_EXTRA_FONT_SRC=https://fonts.example-cdn.com
# SECURITY_HEADERS_CSP_EXTRA_SCRIPT_SRC=https://scripts.example-provider.com
# SECURITY_HEADERS_CSP_EXTRA_STYLE_SRC=https://styles.example-provider.com

# Integration tests stay skipped unless this is set to 1.
RUN_SUPABASE_INTEGRATION_TESTS=0

# Required when RUN_SUPABASE_INTEGRATION_TESTS=1.
# Use local for Supabase local dev, staging for a non-production hosted project,
# or disposable for a short-lived CI/test project.
SUPABASE_INTEGRATION_TARGET=staging

# Optional guard. If this matches the active test project ref, tests refuse to run.
# SUPABASE_PRODUCTION_PROJECT_REF=your-production-project-ref

# Use only when no production Supabase project exists yet. Prefer the project-ref
# guard above once production is created.
# SUPABASE_CONFIRM_NON_PRODUCTION=1

# Optional dedicated test credentials. If omitted, tests use the standard
# NEXT_PUBLIC_SUPABASE_* and SUPABASE_SECRET_KEY/SUPABASE_SERVICE_ROLE_KEY values.
# SUPABASE_INTEGRATION_URL=https://your-staging-project-ref.supabase.co
# SUPABASE_INTEGRATION_PROJECT_REF=your-staging-project-ref
# SUPABASE_INTEGRATION_PUBLISHABLE_KEY=sb_publishable_your_staging_publishable_key
# SUPABASE_INTEGRATION_SECRET_KEY=sb_secret_your_staging_server_secret_key

LOG_LEVEL=info
